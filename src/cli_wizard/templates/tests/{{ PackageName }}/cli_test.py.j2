class TestLogging:
    """Tests for the log module."""

    @pytest.fixture(autouse=True)
    def no_log_file(self):
        """Keep the tests off the configured log file."""
        with patch("{{ PackageName }}.log.LOG_FILE", None):
            yield

    @staticmethod
    def _record(level="ERROR", message="ERROR ahead"):
        """A record at the given level."""
        return logging.makeLogRecord(
            {"levelname": level, "levelno": logging.getLevelName(level), "msg": message}
        )

    @pytest.mark.parametrize(
        ("obj", "kept", "dropped"),
        [
            ({}, "INFO", "DEBUG"),
            ({"log_level": "WARNING"}, "WARNING", "INFO"),
            ({"debug": True, "log_level": "ERROR"}, "DEBUG", None),
        ],
    )
    def test_level_filters_messages(self, capsys, obj, kept, dropped):
        """Test a message below the invocation's level is dropped, none with --debug."""
        with invocation(**obj):
            log(kept, "kept")
            if dropped:
                log(dropped, "dropped")
        err = capsys.readouterr().err
        assert "kept" in err
        assert "dropped" not in err

    @pytest.mark.parametrize(
        ("style", "colors", "expected"),
        [
            ("level", True, "ERROR ahead " + click.style("ERROR", fg=(255, 0, 0))),
            ("full", True, click.style("ERROR ahead ERROR", fg=(255, 0, 0))),
            ("level", False, "ERROR ahead ERROR"),
        ],
    )
    def test_colour_style(self, style, colors, expected):
        """Test the level field alone, or the whole line, is coloured, wherever
        the level sits in the format and whatever the message says."""
        with (
            invocation(colors=colors),
            patch("{{ PackageName }}.log.LOG_FORMAT", "%(message)s %(levelname)s"),
            patch("{{ PackageName }}.log.LOG_COLOR_STYLE", style),
            patch.dict("{{ PackageName }}.log.LOG_COLORS", {"ERROR": "#FF0000"}),
        ):
            assert _formatter(colors=True).format(self._record()) == expected

    def test_format_placeholders(self, capsys):
        """Test every logging placeholder is rendered, not only the three basic ones."""
        with patch("{{ PackageName }}.log.LOG_FORMAT", "%(name)s:%(lineno)d %(message)s"):
            log_info("hello")
        assert re.fullmatch(r"\w+:\d+ hello\n", capsys.readouterr().err)

    @pytest.mark.parametrize(
        ("timezone", "converter"), [("UTC", time.gmtime), ("Local", time.localtime)]
    )
    def test_timestamp_timezone(self, timezone, converter):
        """Test the timestamp is in LOG_TIMEZONE, in LOG_TIMESTAMP_FORMAT."""
        record = self._record()
        with (
            patch("{{ PackageName }}.log.LOG_FORMAT", "%(asctime)s"),
            patch("{{ PackageName }}.log.LOG_TIMEZONE", timezone),
        ):
            timestamp = _formatter(colors=False).format(record)
        assert timestamp == time.strftime(
            constants.LOG_TIMESTAMP_FORMAT, converter(record.created)
        )

    @pytest.mark.parametrize(
        ("hex_color", "rgb"),
        [
            ("#FFFFFF", (255, 255, 255)),
            ("#000000", (0, 0, 0)),
            ("#FF0000", (255, 0, 0)),
            ("#00FF00", (0, 255, 0)),
            ("#0000FF", (0, 0, 255)),
            ("00FF00", (0, 255, 0)),
        ],
    )
    def test_hex_to_rgb(self, hex_color, rgb):
        """Test hex colour to RGB conversion, with or without the hash."""
        assert hex_to_rgb(hex_color) == rgb

    def test_log_to_file(self, tmp_path):
        """Test a logged line is written to LOG_FILE, without colours."""
        log_file = tmp_path / "test.log"
        with patch("{{ PackageName }}.log.LOG_FILE", log_file):
            with invocation(colors=True):
                log_info("Test file logging")
        assert "Test file logging" in log_file.read_text()
        assert "\x1b" not in log_file.read_text()

    def test_log_to_file_outside_an_invocation(self, tmp_path):
        """Test a line logged outside an invocation still reaches LOG_FILE."""
        log_file = tmp_path / "test.log"
        with patch("{{ PackageName }}.log.LOG_FILE", log_file):
            log_info("Test file logging")
        assert "Test file logging" in log_file.read_text()

    def test_log_to_file_rotates_by_size(self, tmp_path):
        """Test file logging rotates once the configured size is exceeded."""
        log_file = tmp_path / "test.log"
        handler = RotatingFileHandler(log_file, maxBytes=100, backupCount=1)
        with (
            patch("{{ PackageName }}.log.LOG_FILE", log_file),
            patch("{{ PackageName }}.log._file_handler", return_value=handler),
            invocation(),
        ):
            for _ in range(10):
                log_info("x" * 50)
        assert (tmp_path / "test.log.1").exists()

    @pytest.mark.parametrize(
        ("rotation", "handler_type"),
        [("size", RotatingFileHandler), ("days", TimedRotatingFileHandler)],
    )
    def test_file_handler_rotation(self, tmp_path, rotation, handler_type):
        """Test the file handler rotates the way LOG_ROTATION_TYPE says."""
        with patch("{{ PackageName }}.log.LOG_ROTATION_TYPE", rotation):
            handler = _file_handler(tmp_path / "test.log")
        handler.close()
        assert isinstance(handler, handler_type)

    def test_logger_is_kept_by_the_invocation(self, tmp_path):
        """Test an invocation opens the log file once and closes it on exit."""
        with patch("{{ PackageName }}.log.LOG_FILE", tmp_path / "test.log"):
            with invocation() as ctx:
                logger = get_logger(ctx)
                assert get_logger(ctx) is logger
                handler = logger.handlers[-1]
                assert isinstance(handler, logging.FileHandler)
                assert handler.stream is not None
        assert handler.stream is None

    def test_no_file_handler_without_log_file(self):
        """Test only the console is written when LOG_FILE is None."""
        handlers = get_logger(None).handlers
        assert not [h for h in handlers if isinstance(h, logging.FileHandler)]


