        """Test JSON payloads are redacted structurally."""
        result = redact_text('{"access_token": "eyJ", "id": 7}')
        assert json.loads(result) == {"access_token": REDACTED, "id": 7}

    def test_redact_text_redacts_non_json_payloads(self):
        """Test form-encoded payloads are redacted by pattern."""
        result = redact_text("access_token=eyJ&expires_in=3600")
        assert "eyJ" not in result
        assert "expires_in=3600" in result

    def test_redact_text_leaves_ordinary_text_intact(self):
        """Test text without credentials passes through unchanged."""
        assert redact_text("<html>Not Found</html>") == "<html>Not Found</html>"


