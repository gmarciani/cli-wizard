class TestRedaction:
    """Tests for credential redaction in debug output."""

    @pytest.mark.parametrize(
        "name", ["password", "Password", "accessToken", "client_secret", "api_key"]
    )
    def test_redact_replaces_credential_values(self, name):
        """Test credential-looking fields are replaced with the marker."""
        assert redact({name: "value"}) == {name: REDACTED}

    @pytest.mark.parametrize("name", ["email", "name", "limit", "id"])
    def test_redact_keeps_ordinary_values(self, name):
        """Test ordinary fields are left readable."""
        assert redact({name: "value"}) == {name: "value"}

    def test_redact_walks_nested_structures(self):
        """Test credentials nested in sub-objects are redacted."""
        result = redact({"users": [{"name": "a", "token": "t"}]})
        assert result == {"users": [{"name": "a", "token": REDACTED}]}

    def test_redact_leaves_the_payload_untouched(self):
        """Test redaction does not mutate its input."""
        payload = {"password": "hunter2"}
        redact(payload)
        assert payload == {"password": "hunter2"}

