                "ascii",
                "+----+-------+-------+\n"
                "| id | name  | tags  |\n"
                "+----+-------+-------+\n"
                "| 1  | alpha | [\"a\"] |\n"
                "| 2  | beta  |       |\n"
                "+----+-------+-------+",
            ),
