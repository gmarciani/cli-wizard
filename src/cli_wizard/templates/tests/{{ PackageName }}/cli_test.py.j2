            render({}, "xml")

    def test_unknown_table_style_is_rejected(self):
        """Test an unknown table style raises instead of picking one."""
        with pytest.raises(ValueError, match="Unknown table style"):
            render_table([], "fancy")

    @pytest.mark.parametrize(
        "style,expected",
        [
            (
                "rounded",
                "╭────┬───────┬───────╮\n"
