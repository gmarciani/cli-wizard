[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ PackageName }}"
dynamic = ["version"]
description = "{{ Description }}"
readme = "README.md"
license = {text = "MIT"}
authors = [
    {name = "{{ AuthorName }}", email = "{{ AuthorEmail }}"}
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
{% for version in PythonVersions %}
    "Programming Language :: Python :: {{ version }}",
{% endfor %}
]
requires-python = ">={{ PythonVersion }}"
dependencies = [
    "click~=8.4",
    "PyYAML~=6.0",
    "requests~=2.34",
]

[project.scripts]
{{ CommandName }} = "{{ PackageName }}.cli:main"

[project.urls]
Homepage = "{{ HomePageUrl }}"
Repository = "{{ RepositoryUrl }}"

# Local-only tooling (PEP 735). Groups are never published, so none of this
# reaches anyone installing {{ PackageName }} from an index. There are no extras:
# the built distributions carry no tests, so a published test extra would only
# install pytest for a consumer with nothing to run it against.
[dependency-groups]
dev = [
    {include-group = "test"},
    {include-group = "docs"},
    "build~=1.5",
    "mypy~=2.3",
    "pre-commit~=4.6",
    "ruff~=0.16.2",
    "tox~=4.58",
    "types-PyYAML~=6.0",
    "types-requests~=2.33",
]
test = [
    "pytest~=9.1",
    "pytest-cov~=7.1",
]
docs = [
    "sphinx~=9.1",
    "sphinx-click~=6.2",
    "sphinx-rtd-theme~=3.1",
]

[tool.setuptools.packages.find]
where = ["src"]
include = ["{{ PackageName }}*"]

[tool.setuptools.package-data]
{{ PackageName }} = ["resources/*"]

[tool.setuptools.dynamic]
version = {file = "VERSION"}

[tool.ruff]
line-length = 88
target-version = "py{{ PythonVersion | replace(".", "") }}"

[tool.ruff.lint]
select = ["E", "F", "W", "I"]

[tool.mypy]
python_version = "{{ PythonVersion }}"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true

[[tool.mypy.overrides]]
module = ["click.*", "requests.*"]
ignore_missing_imports = true

[tool.coverage.run]
omit = ["*/__init__.py"]

# Set here rather than on a tox command line, so every coverage run is gated.
[tool.coverage.report]
fail_under = {{ CoverageThreshold }}

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
