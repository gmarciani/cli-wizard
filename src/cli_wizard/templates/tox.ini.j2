[tox]
envlist = {{ PythonToxEnvs | join(",") }}
isolated_build = True
# Contributors rarely have every supported interpreter installed. CI pins one
# version per job, so nothing is skipped there.
skip_missing_interpreters = true

[testenv]
deps =
    pytest~=9.1
    pytest-cov~=7.1
commands =
    pytest tests/ -v --cov={{ PackageName }} --cov-report=term

[testenv:lint]
deps =
    mypy~=2.3
    ruff~=0.16.2
    types-PyYAML~=6.0
    types-requests~=2.33
commands =
    ruff check src/ tests/
    ruff format --check src/ tests/
    mypy src/

[testenv:format]
deps = ruff~=0.16.2
commands =
    ruff check --fix src/ tests/
    ruff format src/ tests/
