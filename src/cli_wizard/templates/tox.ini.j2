[tox]
envlist = py312,py313,py314
isolated_build = True

[testenv]
deps =
    pytest~=9.1
    pytest-cov~=7.1
commands =
    pytest tests/ -v --cov={{ PackageName }} --cov-report=term

[testenv:lint]
deps =
    mypy~=2.3
    ruff~=0.16.2
    types-PyYAML~=6.0
    types-requests~=2.33
commands =
    ruff check src/ tests/
    ruff format --check src/ tests/
    mypy src/

[testenv:format]
deps = ruff~=0.16.2
commands =
    ruff check --fix src/ tests/
    ruff format src/ tests/
