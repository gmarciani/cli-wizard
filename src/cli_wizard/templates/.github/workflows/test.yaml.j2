name: Test

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: [{% for version in PythonVersions %}'{{ version }}'{% if not loop.last %}, {% endif %}{% endfor %}]

    steps:
    - uses: actions/checkout@v7

    - name: Set up Python ${{ '{{' }} matrix.python-version }}
      uses: actions/setup-python@v7
      with:
        python-version: ${{ '{{' }} matrix.python-version }}

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -e . --group dev

    - name: Lint with ruff
      run: |
        ruff check src/{{ PackageName }} tests/
        ruff format --check src/{{ PackageName }} tests/

    - name: Type check with mypy
      run: mypy src/{{ PackageName }}

    - name: Test with pytest
      run: pytest tests/ -v --cov={{ PackageName }} --cov-report=xml

    # Uploaded once rather than once per interpreter in the matrix.
    - name: Upload coverage to Codecov
      if: matrix.python-version == '{{ PythonVersion }}'
      uses: codecov/codecov-action@v7
      with:
        token: ${{ '{{' }} secrets.CODECOV_TOKEN }}
